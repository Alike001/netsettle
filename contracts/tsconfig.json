{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "skipDefaultLibCheck": true,
    "strict": true
  },
  "exclude": [
    "${configDir}/artifacts",
    "${configDir}/cache",
    "${configDir}/dist",
    "${configDir}/node_modules"
  ],
  "include": [
    "${configDir}/hardhat.config.ts",
    "${configDir}/ignition/**/*.ts",
    "${configDir}/scripts/**/*.ts",
    "${configDir}/src/**/*.ts",
    "${configDir}/test/**/*.ts"
  ]
}
