# Optional public overrides. The app defaults to the verified NetSettle Ethereum Sepolia deployment.
# Never place a private key in Vite variables.
# VITE_NETSETTLE_ADDRESS=0x...
# VITE_DEPLOYMENT_BLOCK=...

# Optional production RPC override for reliable hosted reads.
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
